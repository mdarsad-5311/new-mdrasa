# Madrasa Al-Umaima ERP Backend Configuration

# Security Settings
# In production, generate a secure random 50+ character key and set DEBUG=False
SECRET_KEY=django-insecure-madrasa-al-umaima-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com,.railway.app

# CORS Configuration (Comma-separated)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourfrontenddomain.com

# Database Configuration Options:
# 1. Option A (Universal Cloud DB URL - Render, Railway, Fly.io, Heroku, Supabase, Neon):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# 2. Option B (Explicit SQLite):
DATABASE_ENGINE=sqlite

# 3. Option C (Explicit PostgreSQL parameters):
# DATABASE_ENGINE=postgres
# DB_NAME=madrasa_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Production HTTPS / Security Headers (Set to True when behind HTTPS domain in production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
